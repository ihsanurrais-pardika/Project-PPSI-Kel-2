  "description": "Sistem Informasi Penjadwalan Perkuliahan dan Manajemen Ruang Terintegrasi - FTI Universitas Andalas",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:open": "npm --prefix frontend run dev -- --open",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "db:migrate": "prisma migrate dev && prisma db seed",
    "db:deploy": "prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "siprama",
    "unand",
    "fti",
    "penjadwalan",
    "cp-sat",
    "genetic-algorithm"
  ],
